# systemd unit for running the server without Docker:
#   sudo cp deploy/pixelgame.service /etc/systemd/system/
#   sudo systemctl enable --now pixelgame
[Unit]
Description=Pixelgame multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Pixelgame
EnvironmentFile=/home/ubuntu/Pixelgame/server/.env
Environment=NODE_ENV=production
Environment=SERVE_STATIC=1
Environment=TRUST_PROXY=1
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/index.js
Restart=always
RestartSec=3
# The server saves everything on SIGTERM before it exits.
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
