# Inställningar för Pixelgame-servern. Kopiera till server/.env och fyll i.
# (Raderna som börjar med # är kommentarer.)

# Namnet som visas i serverlistan.
SERVER_NAME=Vår Pixelgame-server
MAX_PLAYERS=50

# --- Inloggning med Supabase (e-post, Google, Discord) ---------------------
# Supabase: Project Settings → API → Project URL och anon/publishable key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bara för äldre Supabase-projekt som signerar med en delad hemlighet
# (Project Settings → API → JWT Secret). Nya projekt behöver inget här.
SUPABASE_JWT_SECRET=

# Gäster utan konto (bra för att testa; stäng av när Supabase fungerar).
ALLOW_GUESTS=0

# Adressen där spelet ligger (skyddar mot andra sidor som försöker ansluta).
# Flera med komma: https://pixelgame.duckdns.org,https://pixelgame.pages.dev
ALLOWED_ORIGINS=

# Konton som får admin-kommandon (/kick, /ban, /tp, /give …): e-post eller id.
ADMINS=

# --- Regler (valfritt) --------------------------------------------------------
# Raidfönster då alla baser kan raidas (svensk tid). "off" stänger av.
RULE_RAID_WINDOW=sat 18:00-21:00
RULE_TIMEZONE=Europe/Stockholm
# Minuter efter att sista klanmedlemmen loggat ut som basen fortfarande kan raidas.
RULE_RAID_GRACE_MINUTES=15
# Andel av det man bär som tappas vid död i vildmarken (0.5 = hälften).
RULE_DEATH_DROP=0.5
# Hardcore: även vapen man inte håller tappas vid död.
RULE_HARDCORE=0
# Timmar som nya spelare är skyddade mot PvP.
RULE_NEWBIE_HOURS=2
RULE_CLAN_MAX=8

# Raidvarningar till en Discord-kanal (Kanalinställningar → Integrationer → Webhooks).
DISCORD_WEBHOOK_URL=

# Fast världsfrö (lämna tomt = slumpas första gången och sparas).
WORLD_SEED=
